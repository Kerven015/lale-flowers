# Copy this file to .env (same folder) and fill it in.

# Password for the shop's database. Letters and digits only.
POSTGRES_PASSWORD=ChangeThisPassword2026

# Port of the shop on this computer: http://localhost:8080
SITE_PORT=8080
# 127.0.0.1 = only this computer. 0.0.0.0 = also phones on your Wi-Fi.
SITE_BIND=127.0.0.1

# ---- on your own computer (testing, http://) keep these: ----
COOKIE_SECURE=0
TRUST_PROXY=0

# ---- on the real server with HTTPS (docker compose --profile https ...) use: ----
# TRUST_PROXY=1 means "believe the visitor's address that Caddy passes on".
# Use it only with SITE_BIND=127.0.0.1 (the default): with 0.0.0.0 anyone could
# skip Caddy, send a made-up address, and get around the login limits.
# COOKIE_SECURE=1
# TRUST_PROXY=1
# DOMAIN=lalegulleri.tm, www.lalegulleri.tm

# If npmjs.org is slow or blocked during the build:
# NPM_REGISTRY=https://registry.npmmirror.com

# "Continue with Google" (optional): the OAuth Client ID from Google Cloud
# Console, see docs/google-sign-in.md. Empty = no Google button.
# GOOGLE_CLIENT_ID=
