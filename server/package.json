{
  "name": "lale-gulleri-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Lale Gülleri shop: products, orders, accounts, admin panel.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "two-step-off": "node --env-file=.env scripts/two-step-off.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "google-auth-library": "^9.15.1",
    "pg": "^8.13.1",
    "qrcode": "1.5.4"
  }
}
