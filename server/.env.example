# Copy this file to .env and fill it in.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://lale:CHANGE_THIS_PASSWORD@127.0.0.1:5432/lale

# Where the server listens. Keep 127.0.0.1 when Nginx is in front of it.
HOST=127.0.0.1
PORT=3000

# Folder for uploaded product photos (relative to the server folder).
UPLOAD_DIR=uploads

# The built website (the dist folder). Leave empty when Nginx serves it.
# Set to ../dist to run the whole shop from this one server (handy for testing).
STATIC_DIR=

# 1 on the real site (HTTPS). 0 only for testing on your own computer (http://).
COOKIE_SECURE=1

# 1 when Nginx is in front of this server (to see visitors' real IP addresses).
TRUST_PROXY=1

# Other addresses the site is opened from, comma separated (usually empty).
ALLOWED_ORIGINS=

NODE_ENV=production

# "Continue with Google" sign-in (optional). The public OAuth Client ID from
# Google Cloud Console, e.g. 1234567890-abc123.apps.googleusercontent.com
# Step by step: docs/google-sign-in.md. Leave empty to hide the Google button
# and One Tap completely. This is NOT a secret (the browser sees it), and no
# client secret is needed.
# GOOGLE_CLIENT_ID=
